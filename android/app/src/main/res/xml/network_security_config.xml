<?xml version="1.0" encoding="utf-8"?>
<!-- HTTP biasa diizinkan untuk server lokal (mis. Laragon di jaringan kantor). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
