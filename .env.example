APP_NAME=Optima
APP_TAGLINE="Warehouse Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Antrean diproses dari penjadwal (schedule:work / cron). Set false bila memakai Supervisor.
QUEUE_IN_SCHEDULER=true
# Kirim stok ke Shopee & TikTok otomatis saat stok berubah.
MARKETPLACE_INSTANT_STOCK_PUSH=true

CACHE_STORE=database
# CACHE_PREFIX=
# Opsional, untuk VPS: pasang redis-server lalu set CACHE_STORE=redis dan QUEUE_CONNECTION=redis
# supaya cache & antrean tidak membebani MySQL. Ganti antrean saat tidak ada job yang menunggu,
# dan ubah perintah worker Supervisor ke `php artisan queue:work redis`.

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
# REDIS_PREFIX= (default: nama aplikasi + nama database, jadi Live & Sandbox tidak bercampur)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Backup offsite (Cloudflare R2 / Backblaze B2 / Wasabi / AWS S3). Kosongkan BACKUP_OFFSITE_DISK untuk mematikan.
BACKUP_OFFSITE_DISK=
BACKUP_OFFSITE_FOLDER=optima
BACKUP_OFFSITE_KEEP_DAYS=30
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com · Backblaze B2: https://s3.<region>.backblazeb2.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Backup database harian (lihat config/backup.php)
BACKUP_TIME=01:00
BACKUP_KEEP_DAYS=14
